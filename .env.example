# Server
PORT=3000
NODE_ENV=development

# Database (relative path or :memory: for tests)
SHRINKR_DB_PATH=data/shrinkr.sqlite

# Session cookie
SHRINKR_COOKIE_SECRET=change-me-in-production

# Web origin allowed to call the API (dev: Vite server)
SHRINKR_WEB_ORIGIN=http://localhost:5173

# Optional: promote a user to platform admin at signup by email
SHRINKR_SEED_ADMIN_EMAIL=
